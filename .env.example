GEMINI_API_KEY=
PORT=3000

# GDF Phase 0/1 Remediation Governance Feature Flags
GDF_STRICT_REAL_DATA_ONLY=true
GDF_ENABLE_MULTI_TIER_WATERFALL=true
GDF_ENABLE_MACRO_REDUNDANCY_FILTER=true
