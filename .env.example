GDF_ENABLE_CIRCUIT_BREAKER_HALT=true
GDF_ENABLE_EMPIRICAL_CALIBRATION=true
GDF_ALLOW_VERIFIED_FIXTURE_REPLAY_IN_TEST=true

# GDF Step 3 Production Architecture & Audit Store Persistence (Priority Order: 1 -> 2 -> /data -> ./data)
GDF_PERSISTENT_DATA_DIR=
