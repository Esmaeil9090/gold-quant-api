    "check:cognitive-hierarchy": "tsx scripts/check-phase6-cognitive-hierarchy.ts",
    "check:full-system-audit": "tsx scripts/check-full-system-audit.ts",
    "check:parallel-universe": "tsx scripts/check-parallel-universe-core.ts",
    "check:scientific-core": "tsx scripts/check-scientific-core.ts",
    "check:mmi-buttons": "tsx scripts/check-mmi-buttons.ts",
    "check:independent-math-audit": "tsx scripts/check-independent-mathematical-audit.ts",
    "check:eight-step-cycle": "tsx scripts/check-eight-step-scientific-cycle.ts",
    "lint": "tsc --noEmit",
    "start": "node server.ts"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "three": "^0.186.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
