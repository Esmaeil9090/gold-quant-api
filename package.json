{
  "name": "gold-quant-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc && tsx scripts/check-phase3-spec-parity.ts && tsx scripts/check-phase4-confidence-metrics.ts && tsx scripts/check-phase5-validation-and-html-guard.ts",
    "check:spec-parity": "tsx scripts/check-phase3-spec-parity.ts",
    "check:confidence-metrics": "tsx scripts/check-phase4-confidence-metrics.ts",
    "check:validation-layer": "tsx scripts/check-phase5-validation-and-html-guard.ts",
    "lint": "tsc --noEmit",
    "start": "node server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
