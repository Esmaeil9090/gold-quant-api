    "check:bilingual-terminology": "tsx scripts/check-bilingual-terminology.ts",
    "check:update-engine": "tsx scripts/check-client-update-engine.ts",
    "check:baseline-integrity": "tsx scripts/check-phase0-baseline-integrity.ts",
    "check:spec-parity": "tsx scripts/check-phase3-spec-parity.ts",
    "check:confidence-metrics": "tsx scripts/check-phase4-confidence-metrics.ts",
